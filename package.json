{
  "description": "Felles frontend-infrastruktur for Team Toi",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "react": "19.3.0",
    "swr": "^2.5.1",
    "typescript": "^6.0.3",
    "zod": "^4.6.2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./analyse": {
      "import": "./dist/analyse/index.js",
      "types": "./dist/analyse/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./miljø": {
      "import": "./dist/miljø/index.js",
      "types": "./dist/miljø/index.d.ts"
    },
    "./next": {
      "import": "./dist/next/index.js",
      "types": "./dist/next/index.d.ts"
    },
    "./swr": {
      "import": "./dist/swr/index.js",
      "types": "./dist/swr/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "name": "@navikt/toi-next-frontend",
  "packageManager": "pnpm@12.4.1",
  "peerDependencies": {
    "react": "^19.0.0",
    "swr": "^2.0.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navikt/toi-next-frontend.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "release": "pnpm test && changeset publish",
    "test": "pnpm build && node --test test/*.test.mjs",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.2.0"
}